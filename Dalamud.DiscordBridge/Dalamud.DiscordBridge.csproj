<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
	<NoWarn>CA1416,CA1862,IDE0003,IDE0060</NoWarn>
    <!-- Plugin identity: Dalamud uses the assembly name as the InternalName (see DiscordChatPears.json). -->
    <AssemblyName>DiscordChatPears</AssemblyName>
    <RootNamespace>Dalamud.DiscordBridge</RootNamespace>
    <!-- Release tags vX.Y.Z must match this (X.Y.Z.0). -->
    <Version>2.3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dalamud.DiscordBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Core" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Rest" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Webhook" Version="3.20.2" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.2" />
    <PackageReference Include="NetStone" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
